            var loadurl = $(e.relatedTarget).attr('data-load-url');
            var extension = loadurl.substr((loadurl.lastIndexOf('.') + 1));
            switch (extension) {
                case 'jpg':
                case 'png':
                case 'gif':
                    $(this).find('.modal-body').html("<img src='" + loadurl + "'/>");
                    $(this).find('.modal-dialog').css({ width: '60%', height: '', 'max-height': '' });
                    break;
                default:
                    $(this).find('.modal-body').html('<iframe width="100%" height="100%" frameborder="0" scrolling="yes" allowtransparency="true" src="' + loadurl + '"></iframe>');
                    $(this).find('.modal-dialog').css({
                        width: '80%',
                        height: '80%',
                        'max-height': '100%'
                    });
                    break;
            }

            $(this).find('.modal-content').css({
                height: '100%',
                'border-radius': '0',
                'padding': '0',
                'text-align': 'center'
            });
            $(this).find('.modal-body').css({
                width: 'auto',
