        function deletefavoris(libelle, idfavoris, action, p1, p2) {
            const reponse = confirm(libelle);
            if (reponse) {
                SpelogAjaxObjects.DeleteFavorite(idfavoris);
                GetFavorites();

                if (action == 'produit_retrait_favoris') {
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        event: 'produit_retrait_favoris',
                        produits: [{
                            produit_famille: p1,
                            produit_nom: p2
                        }]
                    });
                }
                if (action == 'planche_retrait_favoris') {
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        event: 'planche_retrait_favoris',
                        planche_nom: p1,
                        planche_url: p2
                    });
				}
                if (action == 'doc_retrait_favoris') {
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        event: 'doc_retrait_favoris',
                        doc_type: p1,
                        doc_nom: p2
                    });
                }

            } else {
                return false;
            }
        }

        function deletefavorisoffline(libelle, idfavoris, action, p1, p2) {
