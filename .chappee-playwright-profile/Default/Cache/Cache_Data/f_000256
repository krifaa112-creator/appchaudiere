                            produit_nom: p2
                        }]
                    });
                }
                if (action == 'planche_retrait_favoris') {
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        event: 'planche_retrait_favoris',
                        planche_nom: p1,
                        planche_url: p2
                    });
				}
                if (action == 'doc_retrait_favoris') {
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        event: 'doc_retrait_favoris',
                        doc_type: p1,
                        doc_nom: p2
                    });
                }

