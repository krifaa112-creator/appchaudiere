<script>
    function callbackXitiContainer(res) {
        if (res.value.pXtoption) {
            if (res.value.pXitiProtocol == "HTTP")
                initxitiajax(res.value.pEntSite, res.value.pXtsite, res.value.pXtn2, res.value.pXtpage, res.value.pXtdi, res.value.pX1, res.value.pX2, res.value.pX3, res.value.pX4, res.value.pX5, res.value.pX6, res.value.pX7, res.value.pX8, res.value.pX9, res.value.pX10, res.value.pParamsstring);
            if (res.value.pXitiProtocol == "HTTPS")
                initxitiajaxsecure(res.value.pEntSite, res.value.pXtsite, res.value.pXtn2, res.value.pXtpage, res.value.pXtdi, res.value.pX1, res.value.pX2, res.value.pX3, res.value.pX4, res.value.pX5, res.value.pX6, res.value.pX7, res.value.pX8, res.value.pX9, res.value.pX10, res.value.pParamsstring);
        }
    }

    function randomString() {
        var chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXTZabcdefghiklmnopqrstuvwxyz";
        var string_length = 64;
        var randomstring = '';
        for (var i = 0; i < string_length; i++) {
            var rnum = Math.floor(Math.random() * chars.length);
            randomstring += chars.substring(rnum, rnum + 1);
        }
        return randomstring;
    }

    function initxitiajax(pEntSite, pXtsite, pXtn2, pXtpage, pXtdi, pX1, pX2, pX3, pX4, pX5, pX6, pX7, pX8, pX9, pX10, pParamsstring) {
        xtnv = document;        //parent.document or top.document or document 
        xtsd = "http://" + pEntSite;
        xtsite = pXtsite;
        xtn2 = pXtn2;        // level 2 site
        xtpage = pXtpage;        //page name (with the use of :: to create chapters)
        xtdi = pXtdi;        //implication degree 
        xt_multc = pParamsstring;

        if (window.xtparam != null) { window.xtparam += xt_multc; }
        else { window.xtparam = xt_multc; };

        url = 'http://' + pEntSite + '.xiti.com/hit.xiti?s=' + pXtsite + '&s2=' + pXtn2 + '&p=' + pXtpage + '&di=' + xt_multc + '&randomspe=' + randomString();
        $('#IMAGEXITIAJAX').setAttribute("src", url);

        return true;
    }

    function initxitiajaxsecure(pEntSite, pXtsite, pXtn2, pXtpage, pXtdi, pX1, pX2, pX3, pX4, pX5, pX6, pX7, pX8, pX9, pX10, pParamsstring) {
        xtnv = document;        //parent.document or top.document or document 
        xtsd = "https://" + pEntSite;
        xtsite = pXtsite;
        xtn2 = pXtn2;        // level 2 site
        xtpage = pXtpage;        //page name (with the use of :: to create chapters)
        xtdi = pXtdi;        //implication degree 
        xt_multc = pParamsstring;

        if (window.xtparam != null) { window.xtparam += xt_multc; }
        else { window.xtparam = xt_multc; }

        url = 'https://' + pEntSite + '.xiti.com/hit.xiti?s=' + pXtsite + '&s2=' + pXtn2 + '&p=' + pXtpage + '&di=' + xt_multc + '&randomspe=' + randomString();

        $('#IMAGEXITIAJAX').setAttribute("src", url);

        return true;
    }
</script>

